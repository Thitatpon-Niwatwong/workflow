    {
      "parameters": {
        "jsCode": "// n8n Code Node (JavaScript)\n\n// ดึงทุก item จาก input\nconst items = $input.all();\n\n/**\n * สร้างที่อยู่แบบข้อความยาว (raw address) จาก object address\n */\nfunction buildRawAddress(address) {\n  if (!address) return \"\";\n\n  const parts = [];\n\n  // เลขที่บ้าน\n  if (address.houseNo) parts.push(address.houseNo);\n\n  // หมู่\n  if (address.moo) parts.push(\"หมู่ \" + address.moo);\n\n  // หมู่บ้าน\n  if (address.village) parts.push(\"หมู่บ้าน\" + address.village);\n\n  // อาคาร / ชั้น / ห้อง\n  if (address.building) parts.push(\"อาคาร\" + address.building);\n  if (address.floor) parts.push(\"ชั้น \" + address.floor);\n  if (address.room) parts.push(\"ห้อง \" + address.room);\n\n  // ซอย / แยก / ถนน\n  if (address.soi) parts.push(\"ซอย\" + address.soi);\n  if (address.yaek) parts.push(\"แยก \" + address.yaek);\n  if (address.street) parts.push(\"ถนน\" + address.street);\n\n  // แขวง/เขต หรือ ต./อ. (ถ้าไม่ใช่กรุงเทพ)\n  const province = address.province || \"\";\n  const isBangkok = /กรุงเทพมหานคร/.test(province);\n\n  if (address.subDistrict) {\n    parts.push((isBangkok ? \"แขวง \" : \"ต.\") + address.subDistrict);\n  }\n\n  if (address.district) {\n    parts.push((isBangkok ? \"เขต \" : \"อ.\") + address.district);\n  }\n\n  // จังหวัด\n  if (province) {\n    if (isBangkok) {\n      // กรุงเทพมหานคร ไม่ต้องใส่ \"จ.\"\n      parts.push(province);\n    } else {\n      // จังหวัดทั่วไป → เติม \"จ.\"\n      parts.push(\"จ.\" + province);\n    }\n  }\n\n  // รหัสไปรษณีย์\n  if (address.postcode) parts.push(address.postcode);\n\n  // join และเก็บช่องว่างให้เรียบร้อย\n  return parts.join(\" \").replace(/\\s+/g, \" \").trim();\n}\n\n// แปลงทุก item แล้วเพิ่ม field address_raw\nreturn items.map(item => {\n  const data = item.json;\n  const address = data.address || null;\n\n  const raw = buildRawAddress(address);\n\n  return {\n    json: {\n      ...data,\n      address_raw: raw,  // 👉 ที่อยู่แบบ raw address พร้อม \"จ.จังหวัด\"\n    },\n  };\n});\n"
      },
