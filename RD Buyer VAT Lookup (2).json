{
  "name": "RD Buyer VAT Lookup",
  "nodes": [
    {
      "parameters": {
        "method": "POST",
        "url": "https://rdws.rd.go.th/serviceRD3/vatserviceRD3.asmx",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/soap+xml; charset=utf-8",
        "body": "=<soap:Envelope\n    xmlns:soap=\"http://www.w3.org/2003/05/soap-envelope\"\n    xmlns:vat=\"https://rdws.rd.go.th/serviceRD3/vatserviceRD3\">\n\n  <soap:Header/>\n\n  <soap:Body>\n\n    <!-- ===== ตรวจผู้ขาย (Vendor) ===== -->\n    <vat:Service>\n      <vat:TIN>{{ $json.buyer_vat_id }}</vat:TIN>\n      <vat:ProvinceCode>0</vat:ProvinceCode>\n      <vat:BranchNumber>{{ $json.buyer_branch }}</vat:BranchNumber>\n      <vat:AmphurCode>0</vat:AmphurCode>\n    </vat:Service>\n\n  </soap:Body>\n\n</soap:Envelope>\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -2272,
        -48
      ],
      "id": "f67d6e92-828a-41f1-9c18-c66f05ba7fad",
      "name": "HTTP: RD VAT lookup (buyer)",
      "continueOnFail": true
    },
