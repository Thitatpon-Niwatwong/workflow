      "parameters": {
        "jsCode": "const items = $input.all();\n\n// ===== Helpers =====\n\n// ?????????? ? ??????\nconst THAI_DIGITS = \"??????????\";\nfunction toWesternDigits(s) {\n  return String(s ?? \"\").replace(/[?-?]/g, d => String(THAI_DIGITS.indexOf(d)));\n}\n\n// ???????????????? ?\nfunction cleanSpaces(s) {\n  return String(s ?? \"\")\n    .replace(/[\\u00A0\\u1680\\u2000-\\u200D\\u202F\\u205F\\u3000\\uFEFF]/g, \" \")\n    .replace(/[\\t\\r\\n]+/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\n// normalize ?????????? (???????????????????????)\nfunction normalizeThaiAddress(raw) {\n  if (raw == null) return null;\n\n  let s = toWesternDigits(String(raw));\n  s = cleanSpaces(s);\n\n  // --- ?????????????????????????????? ---\n  s = s.replace(/?\\.\\s*(\\d+)/g, \"???? $1\");\n  s = s.replace(/???????\\s*(\\d+)/g, \"???? $1\");\n\n  s = s.replace(/?\\.\\s*/g, \"???? \");\n  s = s.replace(/?\\.\\s*/g, \"????? \");\n  s = s.replace(/?\\.\\s*/g, \"??????? \");\n  s = s.replace(/?\\.\\s*/g, \"??? \");\n\n  // ????? , - ???????????????? ? ??????????????????\n  s = s.replace(/[.,\\-]/g, \" \");\n  \n  s = cleanSpaces(s);\n  return s;\n}\n\n// ???????????????? Subset (???? A ??????? ???????? B ???????)\nfunction isSubset(sourceString, targetString) {\n  if (!sourceString || !targetString) return false;\n\n  // ??? Source ???????\n  const sourceWords = sourceString.split(\" \").filter(w => w.trim().length > 0);\n  \n  // ?? Target ???????????? (????????????????????????????????????)\n  const targetCombined = targetString.replace(/\\s+/g, \"\");\n\n  // ?????????????? Source ??????? Target (Combined)\n  return sourceWords.every(word => targetCombined.includes(word));\n}\n\n// ===== Main =====\n\nconst pdfItem = items.find(it => it.json && it.json.buyer_address_raw !== undefined);\nconst apiItem = items.find(it => it.json && (it.json.address_raw !== undefined || it.json.address));\n\nif (!pdfItem || !apiItem) {\n  return items.map(it => ({\n    json: {\n      ...it.json,\n      buyer_address_status: null,\n      norm_buyer_address: null,\n      norm_api_address: null,\n    },\n  }));\n}\n\nconst pdf = pdfItem.json;\nconst api = apiItem.json;\n\n// ???????? VAT API ????????? ?????????????? error ?????? (????????????????)\nif (api.success === false) {\n  return [{\n    json: {\n      ...pdf,\n      vat_api_error: api.errorMessage || \"\",\n      vat_api_vatId: api.vatId,\n      vat_api_companyName: api.companyName,\n      vat_api_branchNumber: api.branch?.branchNumber,\n      vat_api_branchLabel: api.branch?.branchLabel,\n      vat_api_address_raw: null,\n      norm_buyer_address: null,\n      norm_api_address: null,\n      buyer_address_status: null,\n    },\n  }];\n}\n\n// 1) ?????????? PDF\nconst buyerAddr = pdf.buyer_address_raw;\n\n// 2) ?????????? API (???????????????????)\nlet apiAddr = api.address_raw;\nif (!apiAddr && api.address) {\n  const a = api.address;\n  const parts = [];\n  if (a.houseNo) parts.push(a.houseNo);\n  if (a.moo) parts.push(`???? ${a.moo}`);\n  if (a.subDistrict) parts.push(`????${a.subDistrict}`);\n  if (a.district) parts.push(`?????${a.district}`);\n  if (a.province) parts.push(a.province);\n  if (a.postcode) parts.push(a.postcode);\n  apiAddr = parts.join(\" \");\n}\n\n// Normalize ???????????\nconst normBuyer = normalizeThaiAddress(buyerAddr);\nconst normApi   = normalizeThaiAddress(apiAddr);\n\n// --- Logic ????: Bidirectional Check (???? 2 ???) ---\nlet buyer_address_status = false;\n\nif (normBuyer && normApi) {\n  // ?????????? 1: ???? PDF ???? API ???????\n  const pdfInApi = isSubset(normBuyer, normApi);\n  \n  // ?????????? 2: ???? API ???? PDF ???????\n  const apiInPdf = isSubset(normApi, normBuyer);\n\n  // ???????????????????? ??????????\n  buyer_address_status = pdfInApi || apiInPdf;\n}\n\n// ??????\nreturn [\n  {\n    json: {\n      ...pdf,\n      vat_api_vatId: api.vatId,\n      vat_api_companyName: api.companyName,\n      vat_api_branchNumber: api.branch?.branchNumber,\n      vat_api_branchLabel: api.branch?.branchLabel,\n      vat_api_address_raw: apiAddr,\n\n      norm_buyer_address: normBuyer,\n      norm_api_address: normApi,\n\n      buyer_address_status, \n    },\n  },\n];\n"
      },
