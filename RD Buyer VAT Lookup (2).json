    {
      "parameters": {
        "jsCode": "// Normalize RD VAT SOAP response with error handling\nconst allItems = $input.all();\nconst data = Array.isArray(allItems[0]?.json) ? allItems[0].json : allItems.map(i => i.json ?? {});\n\nfunction clean(val) {\n  const x = String(val ?? '').trim();\n  return x === '-' ? '' : x;\n}\n\nfunction getField(obj, field) {\n  const sr = obj?.[\"soap:Envelope\"]?.[\"soap:Body\"]?.ServiceResponse?.ServiceResult ?? {};\n  const v = sr[field];\n  if (v == null) return '';\n  if (typeof v === 'string' || typeof v === 'number') return String(v);\n  if (v.anyType !== undefined) {\n    const a = v.anyType;\n    if (typeof a === 'string' || typeof a === 'number') return String(a);\n    if (a && typeof a._ !== 'undefined') return String(a._);\n  }\n  if (typeof v._ !== 'undefined') return String(v._);\n  return '';\n}\n\nfunction parseError(obj) {\n  const sr = obj?.[\"soap:Envelope\"]?.[\"soap:Body\"]?.ServiceResponse?.ServiceResult ?? {};\n  return clean(sr.vmsgerr ?? obj.errorMessage ?? obj.error?.message ?? '');\n}\n\nconst out = [];\n\ndata.forEach((item, index) => {\n  const errMsg = parseError(item);\n  const vatId = clean(getField(item, 'vNID'));\n\n  const branchRaw = clean(getField(item, 'vBranchNumber'));\n  const branchNumber = branchRaw === '0' || branchRaw === '' ? '00000' : branchRaw.padStart(5, '0');\n  const branchLabel = branchNumber === '00000' ? '????????????' : `???? ${branchNumber}`;\n\n  const titleName = clean(getField(item, 'vtitleName'));\n  const companyNameMain = clean(getField(item, 'vName'));\n\n  out.push({\n    json: {\n      vatId,\n      companyName: `${titleName} ${companyNameMain}`.trim(),\n      branch: {\n        branchNumber,\n        branchLabel,\n        branchName: clean(getField(item, 'vBranchName')),\n      },\n      address: {\n        houseNo: clean(getField(item, 'vHouseNumber')),\n        moo: clean(getField(item, 'vMooNumber')),\n        village: clean(getField(item, 'vVillageName')),\n        building: clean(getField(item, 'vBuildingName')),\n        floor: clean(getField(item, 'vFloorNumber')),\n        room: clean(getField(item, 'vRoomNumber')),\n        soi: clean(getField(item, 'vSoiName')),\n        street: clean(getField(item, 'vStreetName')),\n        subDistrict: clean(getField(item, 'vThambol')),\n        district: clean(getField(item, 'vAmphur')),\n        province: clean(getField(item, 'vProvince')),\n        postcode: clean(getField(item, 'vPostCode')),\n        yaek: clean(getField(item, 'vYaek')),\n      },\n      businessFirstDate: clean(getField(item, 'vBusinessFirstDate')),\n      errorMessage: errMsg,\n      success: Boolean(vatId && !errMsg),\n    },\n    pairedItem: { item: index },\n  });\n});\n\nreturn out;\n"
      },
